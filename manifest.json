{
  "manifest_version": 3,
  "name": "Juejin Notifier",
  "version": "1.0",
  "description": "Notify when there are new system messages on Juejin.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://juejin.cn/*",
    "*://juejin.im/*",
    "*://api.juejin.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon180.png"
  },
  "icons": {
    "128": "icon128.png",
    "48": "icon48.png",
    "32": "icon32.png",
    "16": "icon16.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://juejin.cn/*",
        "*://juejin.im/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}